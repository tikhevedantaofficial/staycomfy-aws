{
  "Description": "Security Group Configuration for Staycomfy AWS Infrastructure",
  "SecurityGroups": [
    {
      "GroupName": "staycomfy-ec2-sg",
      "Description": "Security group for Staycomfy EC2 backend instance",
      "InboundRules": [
        {
          "Type": "SSH",
          "Protocol": "TCP",
          "PortRange": "22",
          "Source": "YOUR_IP/32",
          "Description": "SSH access from your IP"
        },
        {
          "Type": "HTTP",
          "Protocol": "TCP", 
          "PortRange": "80",
          "Source": "0.0.0.0/0",
          "Description": "HTTP access from anywhere"
        },
        {
          "Type": "HTTPS",
          "Protocol": "TCP",
          "PortRange": "443", 
          "Source": "0.0.0.0/0",
          "Description": "HTTPS access from anywhere"
        },
        {
          "Type": "Custom TCP",
          "Protocol": "TCP",
          "PortRange": "8000",
          "Source": "0.0.0.0/0",
          "Description": "Django development server (optional)"
        }
      ],
      "OutboundRules": [
        {
          "Type": "All Traffic",
          "Protocol": "-1",
          "PortRange": "-1",
          "Destination": "0.0.0.0/0",
          "Description": "Allow all outbound traffic"
        }
      ]
    },
    {
      "GroupName": "staycomfy-dynamodb-sg",
      "Description": "Security group for DynamoDB access (VPC endpoint)",
      "InboundRules": [],
      "OutboundRules": [
        {
          "Type": "HTTPS",
          "Protocol": "TCP",
          "PortRange": "443",
          "Destination": "0.0.0.0/0",
          "Description": "DynamoDB endpoint access"
        }
      ]
    }
  ],
  "SecurityGroupIngressReferences": [
    {
      "SourceGroup": "staycomfy-ec2-sg",
      "TargetGroup": "staycomfy-dynamodb-sg",
      "Description": "Allow EC2 to access DynamoDB"
    }
  ]
}